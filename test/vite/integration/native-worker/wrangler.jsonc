{
	"$schema": "../../../../../node_modules/wrangler/config-schema.json",
	"name": "koze-native-worker-integration",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-24",
	"durable_objects": {
		"bindings": [
			{ "name": "COUNTER", "class_name": "NativeCounter" }
		]
	},
	"exports": {
		"NativeCounter": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
